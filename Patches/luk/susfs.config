# ReSukiSU + SUSFS v2.3.0 内核配置 (OnePlus 8 / luk 内核)
# 由 .github/workflows/build-luk-op8.yml 通过 merge_config.sh 合并进 out/.config
#
# 说明:
#   - CONFIG_KSU=y: 启用 ReSukiSU 驱动 (Kconfig 默认即为 y, 此处显式声明)
#   - CONFIG_KSU_SUSFS=y: 选择 SUSFS inline hook 模式 (Non-GKI 内核必须,
#     同时会关闭默认的 GKI2 tracepoint 钩子选项)
#   - 其余为 SUSFS 各子功能开关 (与 master 分支 patch-susfs 动作保持一致)
#
# !!! 重要约束 (勿在此文件覆盖 luk 原厂 oplus.config 的三态配置) !!!
#   merge_config.sh 按命令行顺序合并, 后面的片段覆盖前面的。本文件在
#   arch/arm64/configs/vendor/oplus.config 之后合并, 因此这里写的任何
#   CONFIG_x=... 都会静默覆盖 luk 的原厂值。
#
#   2026-09 修复: 此处曾有一行 `CONFIG_OPLUS_FEATURE_WIFI_ROUTERBOOST=y`,
#   而 luk 的 oplus.config:51 原厂值为 `=m`。该覆盖导致
#   net/oplus_connectivity_routerboost/ 由「独立模块」变为「静态内建」,
#   构建产物由 oplus_connectivity_routerboost.ko 变为 built-in.o,
#   OOS 侧仍按原厂路径加载该 .ko 而文件已不存在 -> 加载失败。
#   已删除该行, 恢复 luk 原厂 `=m`。详见 Patches/luk/README.md。

CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y

# --- 关闭强制模块签名校验 (双系统兼容必需) ---
# luk 的 kona-perf_defconfig:101-102 带 CONFIG_MODULE_SIG=y + CONFIG_MODULE_SIG_FORCE=y,
# 这是 OPLUS 为 OOS 原厂发布链设置的策略。CONFIG_MODULE_SIG_FORCE=y 意味着
# 「所有」模块必须由本内核构建时的密钥签名, 未签名/他签名的模块一律拒绝加载:
#   - OOS 原厂 vendor_dlkm / system_dlkm 里的 .ko 由一加官方私钥签名,
#     与本内核的构建密钥不同 -> 全部加载失败
#   - 自定义 ROM (LineageOS/crDroid) 侧若使用预编译的 vendor 模块, 同样被拒
# 保留 CONFIG_MODULE_SIG=y (保留签名能力, 模块仍会带签名), 但关闭 FORCE
# (不强制校验), 使两套系统的模块都能加载。
# 注意: 本工作流不打包任何 .ko 进 AnyKernel3 zip (产物只有 Image + dtb.img),
# 因此 OOS 侧依赖的是系统分区里原有的原厂模块, 必须允许其加载。
# CONFIG_MODULE_SIG_FORCE is not set
