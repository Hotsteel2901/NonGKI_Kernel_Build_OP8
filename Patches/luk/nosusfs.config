# BakaSU 配置片段 (SUSFS 关闭 / 手动 syscall 钩子模式) — OnePlus 8 luk 内核
# 由 .github/workflows/build-luk-op8.yml 在 susfs_enable=false 时通过
# merge_config.sh 合并进 out/.config（替代 susfs.config）。
#
# 说明:
#   - CONFIG_KSU=y: 启用 BakaSU 驱动
#   - CONFIG_KSU_MANUAL_HOOK=y: Non-GKI 内核必须走手动钩子（不能走 GKI2 的
#     tracepoint 钩子），内核侧钩子由 Patches/syscall_hook_patches.sh 提供。
#   - CONFIG_KSU_SUSFS=n: 显式关闭 SUSFS（BakaSU 的 Kconfig 默认可能为 y，
#     必须显式写 n，否则会残留 SUSFS 代码而对应的内核补丁并未应用）。
#   - 关闭强制模块签名校验 (双系统兼容必需, 与 susfs.config 一致)。
#
# !!! 重要约束 (与 susfs.config 同) !!!
#   本文件在 arch/arm64/configs/vendor/oplus.config 之后合并，任何 CONFIG_x=...
#   都会静默覆盖 luk 的原厂值。以下配置均不与 luk 原厂配置冲突。

CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KSU_SUSFS is not set

# --- 关闭强制模块签名校验 (双系统兼容必需) ---
# 保留 CONFIG_MODULE_SIG=y (模块仍带签名)，但关闭 FORCE (不强制校验)，
# 使 OOS / 自定义 ROM 的原厂已签名模块都能加载。
# CONFIG_MODULE_SIG_FORCE is not set
