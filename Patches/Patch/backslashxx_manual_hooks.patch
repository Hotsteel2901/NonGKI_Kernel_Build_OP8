+		susfs_ksu_sid = 0;
+	if (security_secctx_to_secid("u:r:priv_app:s0:c512,c768", strlen("u:r:priv_app:s0:c512,c768"), &susfs_priv_app_sid))
+		susfs_priv_app_sid = 0;
+}
+
+bool susfs_is_current_ksu_domain(void)
+{
+	if (unlikely(!susfs_ksu_sid))
+		susfs_populate_sids();
+	return is_ksu_domain();
+}
